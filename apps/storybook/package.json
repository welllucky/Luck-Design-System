{
  "name": "@welllucky/luck-storybook",
  "version": "0.0.0",
  "private": true,
  "description": "Documentação visual do Luck.",
  "type": "module",
  "scripts": {
    "dev": "storybook dev -p 6006 --no-open",
    "build": "storybook build -o storybook-static",
    "test": "vitest run",
