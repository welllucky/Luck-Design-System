    "test:historias": "vitest run --project storybook",
    "test:usabilidade": "vitest run --project usabilidade"
  },
  "dependencies": {
    "@welllucky/luck-core": "workspace:*",
    "@welllucky/luck-styles": "workspace:*",
    "@welllucky/luck-tokens": "workspace:*",
    "lucide": "1.47.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "10.6.0",
    "@storybook/addon-docs": "10.6.0",
    "@storybook/addon-vitest": "10.6.0",
    "@storybook/web-components-vite": "10.6.0",
    "@types/react": "^19.2.0",
    "@vitest/browser-playwright": "4.1.11",
    "axe-core": "4.13.0",
    "lit": "3.3.3",
    "playwright": "1.62.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "remark-gfm": "4.0.1",
    "storybook": "10.6.0",
    "typescript": "~6.0.3",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
