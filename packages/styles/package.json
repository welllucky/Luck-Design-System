{
  "name": "@luck/styles",
  "version": "0.1.0",
  "description": "CSS global do WL3: fontes auto-hospedadas, tokens e base do documento.",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    "./global.css": "./dist/global.css",
    "./base.css": "./dist/base.css",
    "./fonts.css": "./dist/fonts.css",
    "./fonts/*": "./dist/fonts/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rm -rf dist && node scripts/build.ts"
  },
  "dependencies": {
    "@luck/tokens": "workspace:*"
  },
  "devDependencies": {
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@types/node": "^24.0.0"
  }
}
