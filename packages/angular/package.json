{
  "name": "@welllucky/luck-angular",
  "version": "0.1.0",
  "description": "Componentes Angular standalone do Luck (gerados a partir de @welllucky/luck-core), com ngModel e Reactive Forms.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/welllucky/Luck-Design-System.git",
    "directory": "packages/angular"
  },
  "homepage": "https://github.com/welllucky/Luck-Design-System#readme",
  "bugs": {
    "url": "https://github.com/welllucky/Luck-Design-System/issues"
  },
  "publishConfig": {
    "directory": "dist",
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "type": "module",
  "scripts": {
    "build": "rm -rf dist && ng-packagr -p ng-package.json -c tsconfig.json && node scripts/finalize.ts"
  },
  "dependencies": {
    "@welllucky/luck-core": "workspace:*",
    "tslib": "^2.8.0"
  },
  "peerDependencies": {
    "@angular/common": ">=20 <23",
    "@angular/core": ">=20 <23",
    "@angular/forms": ">=20 <23",
    "rxjs": "^7.8.0"
  },
  "devDependencies": {
    "@angular/common": "22.1.7",
    "@angular/compiler": "22.1.7",
    "@angular/compiler-cli": "22.1.7",
    "@angular/core": "22.1.7",
    "@angular/forms": "22.1.7",
    "@angular/platform-browser": "22.1.7",
    "@types/node": "^24.0.0",
    "ng-packagr": "22.1.0",
    "rxjs": "^7.8.2",
    "typescript": "~6.0.3"
  }
}
