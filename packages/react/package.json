{
  "name": "@welllucky/luck-react",
  "version": "0.1.0",
  "description": "Componentes React do Luck (gerados a partir de @welllucky/luck-core).",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/welllucky/Luck-Design-System.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/welllucky/Luck-Design-System#readme",
  "bugs": {
    "url": "https://github.com/welllucky/Luck-Design-System/issues"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@welllucky/luck-core": "workspace:^",
    "@stencil/react-output-target": "1.6.2"
  },
  "peerDependencies": {
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "~6.0.3"
  }
}
